# ─────────────────────────────────────────────────────────────
# Veggies Kitchen — Backend Environment Variables
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to git.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (reset your password on Atlas first)
MONGO_URI=mongodb+srv://adityajmarch020304_db_user:YOUR_NEW_PASSWORD@cluster0.nnm6dcw.mongodb.net/veggie?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI_FALLBACK=

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Sessions (generate a long random string)
SESSION_SECRET=replace_this_with_a_very_long_random_secret_string_at_least_64_chars

# JWT (for mobile auth)
JWT_SECRET=replace_this_with_another_long_random_secret_for_jwt_tokens
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Resend (email notifications)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Firebase Admin SDK (download serviceAccountKey.json from Firebase Console)
# → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
